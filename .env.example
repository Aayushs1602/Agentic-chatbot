# The Lenny Growth Assistant — configuration
#
# Copy to .env and adjust:  cp .env.example .env
# Every value below is a safe default; the stack boots with zero edits.
# Only the CLOUD_API_KEY / ANTHROPIC_API_KEY lines need your own values, and
# both are OPTIONAL — the demo runs entirely on local Ollama.

# ─────────────────────────────────────────────────────────────
# Core                                              [optional]
# ─────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | console  (console is easier to read locally)
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────
# Database                                          [REQUIRED]
# ─────────────────────────────────────────────────────────────
# These three are consumed by the `db` service in docker-compose.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
POSTGRES_PORT=5432

# Consumed by the backend. Inside Compose the host is `db`.
# Running the backend on your host instead? Use localhost:
#   DATABASE_URL=postgresql://lenny:lenny@localhost:5432/lenny
# Using Supabase or Railway instead of local Postgres? Swap this one line —
# the schema is portable, it only needs the `vector` extension available.
DATABASE_URL=postgresql://lenny:lenny@db:5432/lenny
DB_POOL_MIN=1
DB_POOL_MAX=10

# ─────────────────────────────────────────────────────────────
# LLM provider selection                            [REQUIRED]
# ─────────────────────────────────────────────────────────────
# ollama | cloud | anthropic
# `ollama` is the default and the one used for the submitted demo.
LLM_PROVIDER=ollama

# When the active provider is unreachable, fall through to the next healthy
# one instead of failing the request. Set false to surface hard failures.
PROVIDER_FALLBACK=true
PROVIDER_FALLBACK_ORDER=ollama,cloud,anthropic

# ── Local: Ollama (mandatory for the demo) ───────────────────
# Ollama runs on the HOST, not in Compose — GPU passthrough into Docker
# Desktop on Windows/macOS is unreliable. `host.docker.internal` resolves
# back to the host from inside the backend container.
# Running the backend outside Docker? Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# Ollama's default context is 4096 and it truncates SILENTLY. Always set this.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model in VRAM after a request. Cold-loading the 3B
# measured ~77s on a GTX 1650, so without this the first question after any idle
# period is unusably slow. OLLAMA_WARMUP loads it at backend startup instead, so
# the first real user request never pays that cost.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=true
OLLAMA_TIMEOUT_S=120
OLLAMA_TEMPERATURE=0.3

# ── Cloud: any OpenAI-compatible endpoint          [optional] ─
# Default is Google Gemini's OpenAI-compatible surface (free tier).
# Get a key: https://aistudio.google.com/apikey
# Groq works too:   CLOUD_BASE_URL=https://api.groq.com/openai/v1
# OpenAI works too: CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_MODEL=gemini-2.0-flash
CLOUD_API_KEY=
CLOUD_TIMEOUT_S=60

# ── Anthropic Claude Agent SDK                     [optional] ─
# Requires a real API key — a Claude subscription cannot be used to power
# an Agent SDK application. Without a key this provider reports
# available:false in /readyz and is simply absent from the UI toggle.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Embeddings                                        [optional]
# ─────────────────────────────────────────────────────────────
# fastembed | ollama
# fastembed runs on CPU (ONNX). This is deliberate: on a 4GB GPU, sharing
# VRAM between the chat model and an embedding model forces a model swap on
# every query. CPU embeddings keep Ollama holding only the chat model.
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=snowflake/snowflake-arctic-embed-xs
EMBEDDINGS_DIM=384
EMBEDDINGS_BATCH=64
# Used only when EMBEDDINGS_PROVIDER=ollama (nomic-embed-text is 768-dim,
# so EMBEDDINGS_DIM must change to 768 and the corpus must be re-ingested).
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────────────
# Retrieval                                         [optional]
# ─────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8               # chunks passed to the model
RETRIEVAL_CANDIDATES=80         # per retriever, before fusion
RETRIEVAL_MAX_PER_EPISODE=3     # diversity cap
RETRIEVAL_RRF_K=60              # RRF smoothing constant
# SAFETY FLOOR, not the abstain gate. Measurement showed similarity does not
# separate in-corpus from out-of-corpus questions (see
# docs/retrieval-calibration.md), so off-topic detection is a model-based
# relevance check in the orchestrator. This floor only catches degenerate
# states: empty corpus, broken embedder, a query matching nothing.
RETRIEVAL_MIN_SIM=0.35
# Parent-child retrieval: widen each hit by N neighbouring chunks. OFF by
# measurement — at 1 the golden set drops 80% -> 60%. See
# docs/retrieval-calibration.md section 7.
RETRIEVAL_PARENT_WINDOW=0

# ─────────────────────────────────────────────────────────────
# Corpus / ingestion                                [optional]
# ─────────────────────────────────────────────────────────────
TRANSCRIPTS_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts
TRANSCRIPTS_DIR=/data/transcripts
CHUNK_TOKENS=400
CHUNK_OVERLAP=80

# ─────────────────────────────────────────────────────────────
# Frontend                                          [optional]
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# Where SKILL.md files live. Leave blank to auto-detect.
SKILLS_DIR=/app/skills
